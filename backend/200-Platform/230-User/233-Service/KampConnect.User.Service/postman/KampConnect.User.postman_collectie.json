{
  "info": {
    "_postman_id": "a1f3c9e2-5b7d-4c18-8e2a-kcusercol00001",
    "name": "KampConnect User Service",
    "description": "Requests voor de User-service.\n\n1. Importeer deze collectie en de environment uit backend/postman.\n2. Start de Identity-service en de User-service.\n3. Selecteer de environment \"KampConnect - Local\" in Postman.\n4. Haal een token op via de collectie > tabblad Authorization > \"Get New Access Token\".",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "oauth2",
    "oauth2": [
      {
        "key": "grant_type",
        "value": "authorization_code_with_pkce",
        "type": "string"
      },
      {
        "key": "authUrl",
        "value": "{{identityHost}}/oauth2/authorize",
        "type": "string"
      },
      {
        "key": "accessTokenUrl",
        "value": "{{identityHost}}/oauth2/token",
        "type": "string"
      },
      {
        "key": "clientId",
        "value": "{{clientId}}",
        "type": "string"
      },
      {
        "key": "scope",
        "value": "{{scope}}",
        "type": "string"
      },
      {
        "key": "redirect_uri",
        "value": "{{callbackUrl}}",
        "type": "string"
      },
      {
        "key": "challengeAlgorithm",
        "value": "S256",
        "type": "string"
      },
      {
        "key": "addTokenTo",
        "value": "header",
        "type": "string"
      },
      {
        "key": "client_authentication",
        "value": "body",
        "type": "string"
      },
      {
        "key": "tokenName",
        "value": "KampConnect User",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "User",
      "item": [
        {
          "name": "Gebruiker aanmaken (met token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Verwacht: 200 bij eerste aanmaak, 409 als het profiel al bestaat.",
                  "pm.test('Status is 200 of 409', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 409]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Test\",\n  \"lastName\": \"Gebruiker\",\n  \"birthDate\": \"2005-01-01\",\n  \"preferredLanguage\": \"nl\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{userHost}}/api/user/create",
              "host": [ "{{userHost}}" ],
              "path": [ "api", "user", "create" ]
            },
            "description": "Maakt het gebruikersprofiel aan voor de ingelogde gebruiker (sub-claim uit het token)."
          }
        },
        {
          "name": "Huidige gebruiker (met token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Verwacht: 200 als het profiel bestaat, 404 als het nog niet aangemaakt is.",
                  "pm.test('Status is 200 of 404', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{userHost}}/api/user/me",
              "host": [ "{{userHost}}" ],
              "path": [ "api", "user", "me" ]
            },
            "description": "Gebruikt de OAuth2-instellingen van de collectie."
          }
        },
        {
          "name": "Huidige gebruiker (met bewaarde accessToken)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{userHost}}/api/user/me",
              "host": [ "{{userHost}}" ],
              "path": [ "api", "user", "me" ]
            },
            "description": "Plak een access token in de environment-variabele {{accessToken}}."
          }
        },
        {
          "name": "Huidige gebruiker (zonder token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Zonder token: 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{userHost}}/api/user/me",
              "host": [ "{{userHost}}" ],
              "path": [ "api", "user", "me" ]
            }
          }
        }
      ]
    },
    {
      "name": "Address",
      "description": "Adressen van de ingelogde gebruiker. Het gebruikersprofiel moet eerst aangemaakt zijn (User > Gebruiker aanmaken).\n\naddressType: 0 = Home, 1 = Other.\n\nElk nieuw adres wordt geverifieerd via de Google Address Validation API. Het adres wordt altijd opgeslagen. Bevestigt Google het adres niet (of is Google onbereikbaar), dan bevat verificationMessage de reden.",
      "item": [
        {
          "name": "Adres toevoegen (bestaand adres)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Verwacht: 200 en een door Google bevestigd adres.",
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Adres is gevalideerd (geen verificationMessage)', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.succeeded).to.be.true;",
                  "    pm.expect(json.verificationMessage).to.be.oneOf([null, '']);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"addressType\": 0,\n  \"street\": \"Grote Markt\",\n  \"houseNumber\": \"1\",\n  \"box\": \"\",\n  \"postalCode\": \"1000\",\n  \"city\": \"Brussel\",\n  \"countryCode\": \"BE\",\n  \"isPrimary\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{userHost}}/api/address/me",
              "host": [ "{{userHost}}" ],
              "path": [ "api", "address", "me" ]
            },
            "description": "Voegt een adres toe voor de ingelogde gebruiker. Google normaliseert de waarden (bv. schrijfwijze van de straat)."
          }
        },
        {
          "name": "Adres toevoegen (onbestaand adres)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Verwacht: 200, adres opgeslagen maar niet gevalideerd.",
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Adres is niet gevalideerd en heeft een boodschap', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.succeeded).to.be.true;",
                  "    pm.expect(json.verificationMessage).to.be.a('string').and.not.be.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"addressType\": 1,\n  \"street\": \"Onbestaandestraat\",\n  \"houseNumber\": \"9999\",\n  \"box\": \"\",\n  \"postalCode\": \"9999\",\n  \"city\": \"Nergensdorp\",\n  \"countryCode\": \"BE\",\n  \"isPrimary\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{userHost}}/api/address/me",
              "host": [ "{{userHost}}" ],
              "path": [ "api", "address", "me" ]
            },
            "description": "Een adres dat Google niet kan bevestigen. Wordt toch opgeslagen, met een verificationMessage in de response."
          }
        },
        {
          "name": "Adres toevoegen (zonder token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Zonder token: 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"addressType\": 0,\n  \"street\": \"Grote Markt\",\n  \"houseNumber\": \"1\",\n  \"box\": \"\",\n  \"postalCode\": \"1000\",\n  \"city\": \"Brussel\",\n  \"countryCode\": \"BE\",\n  \"isPrimary\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{userHost}}/api/address/me",
              "host": [ "{{userHost}}" ],
              "path": [ "api", "address", "me" ]
            }
          }
        },
