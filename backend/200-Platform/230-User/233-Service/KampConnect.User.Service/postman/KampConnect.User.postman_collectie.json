              "raw": "{{userHost}}/api/address/me",
              "host": [ "{{userHost}}" ],
              "path": [ "api", "address", "me" ]
            }
          }
        }
      ]
    },
    {
      "name": "Family",
      "description": "Gezinnen van de ingelogde gebruiker. Het gebruikersprofiel moet eerst aangemaakt zijn (User > Gebruiker aanmaken).\n\nVoer \"Gezin aanmaken\" eerst uit: die bewaart {{familyId}} als collectievariabele. \"Leden ophalen\", \"Kind toevoegen\" en \"Uitnodiging aanmaken\" bewaren respectievelijk {{memberId}}, {{inviteId}} en {{inviteCode}}.\n\nroleType: 1 = guardian, 2 = child.\nstatus: 1 = pending, 2 = active, 3 = rejected, 4 = removed.",
      "item": [
        {
          "name": "Gezinnen",
          "item": [
            {
              "name": "Gezin aanmaken",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Status is 201', function () {",
                      "    pm.response.to.have.status(201);",
                      "});",
                      "",
                      "const json = pm.response.json();",
                      "if (json && json.familyId) {",
                      "    pm.collectionVariables.set('familyId', json.familyId);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Familie Test\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{userHost}}/api/family",
                  "host": [ "{{userHost}}" ],
                  "path": [ "api", "family" ]
                },
                "description": "Maakt een nieuw gezin aan met de ingelogde gebruiker als guardian."
              }
            },
            {
              "name": "Gezinnen ophalen",
