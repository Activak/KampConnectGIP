          "name": "Adressen ophalen (met token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{userHost}}/api/address/me",
              "host": [ "{{userHost}}" ],
              "path": [ "api", "address", "me" ]
            },
            "description": "Haalt alle adressen van de ingelogde gebruiker op."
          }
        },
        {
          "name": "Adressen ophalen (zonder token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Zonder token: 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
