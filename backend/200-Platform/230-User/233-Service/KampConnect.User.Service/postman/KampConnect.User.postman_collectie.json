                  "listen": "test",
                  "script": {
                    "exec": [
                      "// Verwacht: 202 Accepted, het lid wacht op goedkeuring. 429 bij te veel pogingen.",
                      "pm.test('Status is 202', function () {",
                      "    pm.response.to.have.status(202);",
                      "});"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
