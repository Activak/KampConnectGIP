        {
          "name": "Uitnodigingen",
          "item": [
            {
              "name": "Uitnodiging aanmaken",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Status is 200', function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "const json = pm.response.json();",
                      "if (json) {",
                      "    pm.collectionVariables.set('inviteId', json.familyInviteId);",
                      "    pm.collectionVariables.set('inviteCode', json.code);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
