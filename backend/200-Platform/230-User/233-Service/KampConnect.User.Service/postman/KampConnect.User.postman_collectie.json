                  }
                }
              ],
              "request": {
                "method": "PATCH",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"role\": 1,\n  \"isPrimaryContact\": false\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{userHost}}/api/family/{{familyId}}/members/{{memberId}}",
                  "host": [ "{{userHost}}" ],
                  "path": [ "api", "family", "{{familyId}}", "members", "{{memberId}}" ]
                },
                "description": "role: 1 = guardian, 2 = child. Beide velden zijn optioneel."
              }
            },
