        {
          "name": "Leden",
          "item": [
            {
              "name": "Kind toevoegen",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Status is 200', function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "const json = pm.response.json();",
                      "if (json && json.familyMemberId) {",
                      "    pm.collectionVariables.set('memberId', json.familyMemberId);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"firstName\": \"Kind\",\n  \"lastName\": \"Test\",\n  \"birthDate\": \"2015-06-15\",\n  \"preferredLanguage\": \"nl\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{userHost}}/api/family/{{familyId}}/children",
                  "host": [ "{{userHost}}" ],
                  "path": [ "api", "family", "{{familyId}}", "children" ]
                },
                "description": "Voegt een kind toe aan het gezin en bewaart {{memberId}}."
              }
            },
            {
              "name": "Leden ophalen",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Status is 200', function () {",
                      "    pm.response.to.have.status(200);",
                      "});"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{userHost}}/api/family/{{familyId}}/members",
                  "host": [ "{{userHost}}" ],
                  "path": [ "api", "family", "{{familyId}}", "members" ]
                }
              }
            },
            {
              "name": "Wachtende leden ophalen",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Status is 200', function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "// Bewaar het eerste wachtende lid om goed te keuren of te weigeren",
                      "const json = pm.response.json();",
                      "if (Array.isArray(json) && json.length > 0) {",
                      "    pm.collectionVariables.set('memberId', json[0].familyMemberId);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{userHost}}/api/family/{{familyId}}/members?status=1",
                  "host": [ "{{userHost}}" ],
                  "path": [ "api", "family", "{{familyId}}", "members" ],
                  "query": [
                    {
                      "key": "status",
                      "value": "1",
                      "description": "1 = pending, 2 = active, 3 = rejected, 4 = removed"
                    }
                  ]
                }
              }
            },
            {
              "name": "Lid aanpassen",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Status is 200', function () {",
